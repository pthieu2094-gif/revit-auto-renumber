<?xml version="1.0" encoding="utf-8"?>
<RevitAddIns>
  <!--
    Sheet Numbering Revit Add-in for Revit 2025

    Installation Instructions:
    1. Build the project in Visual Studio
    2. Copy the output DLL to your desired location
    3. Update the Assembly path below to point to your DLL location
    4. Copy this .addin file to:
       %AppData%\Autodesk\Revit\Addins\2025\
    5. Restart Revit 2025

    IMPORTANT: Update the Assembly path below to match your DLL location!
  -->

  <AddIn Type="Application">
    <!-- External Application for Ribbon -->
    <Assembly>C:\Users\DUAN\Desktop\TOOL API\Renumber Sheets\dist\Revit2025\SheetNumberingRevit.dll</Assembly>
    <FullClassName>SheetNumberingRevit.App</FullClassName>
    <ClientId>8A3E4F1B-2C5D-4E6F-9A7B-1C2D3E4F5A6B</ClientId>
    <Name>SheetNumberingRevit_App</Name>
    <VendorId>TOOLS API</VendorId>
    <VendorDescription>TOOLS API - Sheet Numbering Add-in</VendorDescription>
  </AddIn>

  <AddIn Type="Command">
    <!-- External Command for Renumber Sheets -->
    <Assembly>C:\Users\DUAN\Desktop\TOOL API\Renumber Sheets\dist\Revit2025\SheetNumberingRevit.dll</Assembly>
    <FullClassName>SheetNumberingRevit.RenumberSheetsCommand</FullClassName>
    <ClientId>7B9C8D0E-1F2A-3B4C-5D6E-7F8A9B0C1D2E</ClientId>
    <Name>Renumber Sheets</Name>
    <VendorId>TOOLS API</VendorId>
    <VendorDescription>TOOLS API - Sheet Numbering Add-in</VendorDescription>
  </AddIn>

</RevitAddIns>
